<Window
    x:Class="Hammer5Git.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Hammer5Git.Core.Models"
    xmlns:vm="using:Hammer5Git.App.ViewModels"
    Title="CS2 Hammer5Git">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Row 0: Immersive Fluent Custom TitleBar -->
            <RowDefinition Height="46" />
            <!-- Row 1: Emergency Crash Interception Banner -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: File Tree + Timeline & Multi-File Diff Workspace -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: IMMERSIVE FLUENT TITLE BAR ==================== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightCaptionInsetColumn" Width="140" />
            </Grid.ColumnDefinitions>

            <!-- Brand Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE7C3;" FontSize="13" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Hammer5Git"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <!-- Left Interactive Panel: Addon Dropdown Selector + Remove Button + Add Button + Load Repo Button -->
            <StackPanel x:Name="TitleBarLeftInteractivePanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center">
                <ComboBox x:Name="AddonSelectorComboBox"
                          MinWidth="195"
                          MaxWidth="260"
                          ItemsSource="{x:Bind ViewModel.Addons, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedAddon, Mode=TwoWay}"
                          PlaceholderText="未添加任何项目">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:AddonProfile">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE930;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind AddonName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button x:Name="RemoveAddonButton"
                        Click="OnRemoveAddonClick"
                        IsEnabled="{x:Bind ViewModel.HasSelectedAddon, Mode=OneWay}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="移除当前项目">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                        <TextBlock Text="移除项目" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button x:Name="AddAddonButton"
                        Click="OnAddAddonClick"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="从 CS2 content/csgo_addons 目录添加地图项目">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="添加项目" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button x:Name="LoadRepoButton"
                        Click="OnLoadRepoClick"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="从本地或远程 Git 仓库载入并同步到 CS2">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                        <TextBlock Text="载入仓库" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Center Draggable Region -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Border Visibility="{x:Bind ViewModel.DmxWarningVisibility, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="12"
                        Padding="10,3">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="未找到 dmxconvert.exe"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right Interactive Panel: Refresh / Sync / Push / Open Folder / Repo Config + Theme / Global Settings -->
            <StackPanel x:Name="TitleBarRightInteractivePanel"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                <Button Click="OnRefreshHistoryClick"
                        IsEnabled="{x:Bind ViewModel.HasSelectedAddon, Mode=OneWay}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="刷新提交历史与文件树">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="刷新" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Click="OnManualSyncNowClick"
                        IsEnabled="{x:Bind ViewModel.HasSelectedAddon, Mode=OneWay}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="立即同步变更">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE895;" FontSize="12" />
                        <TextBlock Text="同步" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Click="OnPushRemoteClick"
                        IsEnabled="{x:Bind ViewModel.HasSelectedAddon, Mode=OneWay}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="推送至远程仓库">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE898;" FontSize="12" />
                        <TextBlock Text="推送" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Click="OnOpenShadowRepoDirClick"
                        IsEnabled="{x:Bind ViewModel.HasSelectedAddon, Mode=OneWay}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="打开影子仓库文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                        <TextBlock Text="打开仓库" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Click="OnAddonConfigClick"
                        IsEnabled="{x:Bind ViewModel.HasSelectedAddon, Mode=OneWay}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="仓库配置">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8F1;" FontSize="12" />
                        <TextBlock Text="仓库配置" FontSize="12" />
                    </StackPanel>
                </Button>

                <Border Width="1"
                        Height="16"
                        Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        VerticalAlignment="Center" />

                <Button x:Name="ThemeToggleButton"
                        Click="OnThemeToggleClick"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="切换深色/浅色主题">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontSize="12" />
                        <TextBlock Text="主题切换" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button x:Name="GlobalSettingsButton"
                        Click="OnGlobalSettingsClick"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,5"
                        ToolTipService.ToolTip="全局设置">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE713;" FontSize="12" />
                        <TextBlock Text="设置" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== ROW 1: EMERGENCY CRASH INTERCEPTION BANNER ==================== -->
        <InfoBar x:Name="CrashAlertBanner"
                 Grid.Row="1"
                 Margin="12,0,12,8"
                 Severity="Error"
                 IsOpen="False"
                 IsClosable="True"
                 Title="拦截到损坏的 VMAP 文件！">
            <InfoBar.ActionButton>
                <Button Content="一键恢复最近有效版本"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="OnEmergencyRestoreLatestClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- ==================== ROW 2: FILE TREE + TIMELINE & DIFF WORKSPACE ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left Column: Collapsible Project File Tree (Mica surface) -->
                <ColumnDefinition Width="250" />
                <!-- Right Column: Layered Content Surface -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Selected Addon Tracked File Tree (Native WinUI TreeView) -->
            <TreeView x:Name="FileTreeView"
                      Grid.Column="0"
                      Padding="6,4,6,8"
                      SelectionMode="Single"
                      ItemInvoked="OnFileTreeItemInvoked">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileTreeViewNode">
                        <StackPanel Orientation="Horizontal" Spacing="6" Padding="2,2">
                            <FontIcon Glyph="{x:Bind NodeData.IconGlyph}"
                                      FontSize="13"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind NodeData.DisplayName}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Right Column: Layered Fluent Workspace Card -->
            <Border Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <Grid>
                    <!-- Empty State when no custom Addon exists -->
                    <StackPanel Visibility="{x:Bind ViewModel.SelectedAddonEmptyVisibility, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                        <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="未添加任何项目"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Button Content="添加新项目"
                                HorizontalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnAddAddonClick" />
                    </StackPanel>

                    <!-- Active Addon Two-Column Split: Commit History Timeline + Multi-File Diff Preview -->
                    <Grid Visibility="{x:Bind ViewModel.SelectedAddonWorkspaceVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <!-- Commit History Column -->
                            <ColumnDefinition Width="340" />
                            <!-- Multi-File Diff & Per-File Action Column -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Sub-Column: Commit History Timeline -->
                        <Border Grid.Column="0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,1,0"
                                Padding="10,10">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Padding="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentFilterTitle, Mode=OneWay}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="130"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.Commits.Count, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <!-- AutoSave Filter ToggleButton -->
                                        <ToggleButton IsChecked="{x:Bind ViewModel.ShowAutoSaveCommits, Mode=TwoWay}"
                                                      Padding="6,4"
                                                      ToolTipService.ToolTip="显示/隐藏自动保存草稿提交">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE74E;" FontSize="11" />
                                                <TextBlock Text="自动保存" FontSize="11" />
                                            </StackPanel>
                                        </ToggleButton>

                                        <!-- Milestone Tag Flyout Button -->
                                        <Button Margin="0,0,2,0"
                                                Padding="6,4"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                IsEnabled="{x:Bind ViewModel.HasSelectedCommit, Mode=OneWay}"
                                                ToolTipService.ToolTip="添加里程碑标签">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE8EC;" FontSize="11" />
                                                <TextBlock Text="打标签" FontSize="11" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout x:Name="AddTagFlyout" Placement="BottomEdgeAlignedRight">
                                                    <StackPanel Width="240" Spacing="8">
                                                        <TextBox x:Name="TagInputBox"
                                                                 PlaceholderText="输入标签名 (如 v1_alpha)"
                                                                 FontSize="12" />
                                                        <Button Content="确认打标"
                                                                HorizontalAlignment="Stretch"
                                                                Style="{ThemeResource AccentButtonStyle}"
                                                                Click="OnAddTagClick" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>

                                </Grid>

                                <ListView x:Name="CommitsListView"
                                          Grid.Row="1"
                                          ItemsSource="{x:Bind ViewModel.Commits, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedCommit, Mode=TwoWay}"
                                          SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:CommitRecord">
                                            <Grid Margin="0,3">
                                                <!-- Main Branch Card -->
                                                <Border Visibility="{x:Bind IsMainBranch}"
                                                        Padding="8,8,10,8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left Accent Bar (Main: Theme Accent Color) -->
                                                        <Border Grid.Column="0"
                                                                Width="3"
                                                                CornerRadius="1.5"
                                                                VerticalAlignment="Stretch"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}" />

                                                        <StackPanel Grid.Column="1" Spacing="5">
                                                            <Grid ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0"
                                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                        CornerRadius="4"
                                                                        Padding="5,1">
                                                                    <TextBlock Text="{x:Bind ShortHash}"
                                                                               FontFamily="Consolas"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                                </Border>

                                                                <Border Grid.Column="1"
                                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                        CornerRadius="4"
                                                                        Padding="5,1">
                                                                    <TextBlock Text="MAIN"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                                </Border>

                                                                <Border Grid.Column="2"
                                                                        Visibility="{x:Bind HasTag}"
                                                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                        CornerRadius="4"
                                                                        Padding="5,1">
                                                                    <TextBlock Text="{x:Bind TagSummary}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                                </Border>

                                                                <TextBlock Grid.Column="3"
                                                                           Text="{x:Bind DisplayTime}"
                                                                           FontSize="11"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            </Grid>

                                                            <TextBlock Text="{x:Bind CleanSubject}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       MaxLines="2"
                                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- AutoSave Branch Card -->
                                                <Border Visibility="{x:Bind IsAutoSave}"
                                                        Padding="8,8,10,8"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left Accent Bar (AutoSave: Amber/Caution Color) -->
                                                        <Border Grid.Column="0"
                                                                Width="3"
                                                                CornerRadius="1.5"
                                                                VerticalAlignment="Stretch"
                                                                Background="{ThemeResource SystemFillColorCautionBrush}" />

                                                        <StackPanel Grid.Column="1" Spacing="5">
                                                            <Grid ColumnSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0"
                                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                        CornerRadius="4"
                                                                        Padding="5,1">
                                                                    <TextBlock Text="{x:Bind ShortHash}"
                                                                               FontFamily="Consolas"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Border>

                                                                <Border Grid.Column="1"
                                                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                        CornerRadius="4"
                                                                        Padding="5,1">
                                                                    <TextBlock Text="AUTOSAVE"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                                </Border>

                                                                <Border Grid.Column="2"
                                                                        Visibility="{x:Bind HasTag}"
                                                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                        CornerRadius="4"
                                                                        Padding="5,1">
                                                                    <TextBlock Text="{x:Bind TagSummary}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                                </Border>

                                                                <TextBlock Grid.Column="3"
                                                                           Text="{x:Bind DisplayTime}"
                                                                           FontSize="11"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            </Grid>

                                                            <TextBlock Text="{x:Bind CleanSubject}"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       MaxLines="2"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Right Sub-Column: Unified Multi-File Preview Window (File Header + 100-Line Diff per File) -->
                        <Grid Grid.Column="1" Padding="10,10">
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="0,4">
                                <ListView x:Name="DiffListView"
                                          ItemsSource="{x:Bind ViewModel.DiffLines, Mode=OneWay}"
                                          SelectionMode="None"
                                          IsItemClickEnabled="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollMode="Enabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="20" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DiffLineViewModel">
                                            <Grid>
                                                <!-- 1. File Header Bar (Full Relative Path + Stats + 4 Per-File Buttons) -->
                                                <Border Visibility="{x:Bind FileHeaderVisibility}"
                                                        Margin="8,6,8,4"
                                                        Padding="10,6"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind FileStatus}"
                                                                       FontFamily="Consolas"
                                                                       FontWeight="Bold"
                                                                       FontSize="11"
                                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        </Border>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{x:Bind RepoRelativePath}"
                                                                   FontFamily="Consolas"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   IsTextSelectionEnabled="True"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTipService.ToolTip="{x:Bind FullDiskPath}"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{x:Bind FileStatsText}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Content="打开文件"
                                                                    Tag="{x:Bind RepoRelativePath}"
                                                                    Padding="8,3"
                                                                    FontSize="11"
                                                                    Click="OnOpenFileFromDiffClick"
                                                                    ToolTipService.ToolTip="{x:Bind FullDiskPath}" />

                                                            <Button Content="历史更改"
                                                                    Tag="{x:Bind RepoRelativePath}"
                                                                    Padding="8,3"
                                                                    FontSize="11"
                                                                    Click="OnFilterFileHistoryFromDiffClick" />

                                                            <Button Content="另存为"
                                                                    Tag="{x:Bind RepoRelativePath}"
                                                                    Padding="8,3"
                                                                    FontSize="11"
                                                                    Click="OnRestoreSaveAsCopyFromDiffClick" />

                                                            <Button Content="恢复"
                                                                    Tag="{x:Bind RepoRelativePath}"
                                                                    Padding="8,3"
                                                                    FontSize="11"
                                                                    Style="{ThemeResource AccentButtonStyle}"
                                                                    Click="OnRestoreOverwriteFromDiffClick" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- 2. Colored Diff Code Line -->
                                                <Grid Visibility="{x:Bind CodeRowVisibility}"
                                                      Background="{x:Bind RowBackground}"
                                                      Padding="8,1"
                                                      ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{x:Bind LineIndexText}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind Prefix}"
                                                               FontFamily="Consolas"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{x:Bind TextForeground}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind Content}"
                                                               FontFamily="Consolas"
                                                               FontSize="12"
                                                               IsTextSelectionEnabled="True"
                                                               TextWrapping="NoWrap"
                                                               Foreground="{x:Bind TextForeground}" />
                                                </Grid>

                                                <!-- 3. Per-File >100 Lines Truncation Expand Button -->
                                                <Border Visibility="{x:Bind TruncationRowVisibility}"
                                                        Margin="8,2,8,8"
                                                        Padding="8,4"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4">
                                                    <Button Content="{x:Bind TruncationButtonText}"
                                                            Tag="{x:Bind RepoRelativePath}"
                                                            HorizontalAlignment="Center"
                                                            Style="{ThemeResource SubtleButtonStyle}"
                                                            Padding="10,3"
                                                            FontSize="11"
                                                            Click="OnExpandFileDiffClick" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
