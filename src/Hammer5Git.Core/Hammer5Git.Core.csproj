<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\dist\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- KeyValues2 (Datamodel.NET): https://github.com/ValveResourceFormat/Datamodel.NET -->
    <PackageReference Include="KeyValues2" Version="1.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.14" />
  </ItemGroup>

</Project>
